# ==========================================
# PUBLIC ENVIRONMENT VARIABLES (Exposed to Browser)
# Prefix with NEXT_PUBLIC_ to expose to Client Components
# ==========================================

# Base API URL used by RTK Query fetchBaseQuery
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Application Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# KEYCLOAK & SERVICE CONFIGURATION
# ==========================================
JWT_ISSUER_URI=https://example.com
DB_URL=jdbc:postgresql://localhost:8989/devsolve
DB_USERNAME=devsolve
DB_PASSWORD=your_db_password
MINIO_URL=https://file.quizzy.it.com/
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=products
KEYCLOAK_SERVER_URL=https://auth.quizzy.it.com/
KEYCLOAK_REALM=devsolve
KEYCLOAK_CLIENT_ID=devsolve-admin
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
KEYCLOAK_TARGET_REALM=devsolve
