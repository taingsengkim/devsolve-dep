# The origin the app is served from. Also the base for every canonical URL,
# sitemap entry and social card, so in production it must be the real public
# domain — a loopback value here is ignored by the SEO layer rather than
# published as a canonical no crawler can reach.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keycloak
KEYCLOAK_CLIENT_ID=client-id
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=https://yourdomain.com/realms/your-realm

# Backend REST API
BACKEND_API_URL=http://localhost:8999/api/v1
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8999/api/v1

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Search engine webmaster verification
# Obtain these tokens from the respective webmaster portals after adding the
# site, then deploy them. Leave blank in development — missing values are
# simply omitted from <head> rather than emitting an empty/invalid tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
